+  function cargarCuotaEmail(){
+    var chip = $("chipEmail");
+    if(!chip) return;
+    fetch(SCRIPT_URL + "?accion=cuotaEmail&_=" + Date.now(), { cache:"no-store" })
+      .then(function(r){ if(!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
+      .then(function(res){
+        if(!res || res.ok === false || typeof res.restante !== "number") throw new Error("acción no disponible");
+        var pendientes = Number(res.pendientes || 0);
+        chip.style.display = "inline-block";
+        chip.className = "chip-hora" + (res.restante <= 10 ? " alerta-am" : "");
+        chip.textContent = "✉️ Correos disponibles: " + res.restante + (pendientes ? " · Pendientes: " + pendientes : "");
+      })
+      .catch(function(){ chip.style.display = "none"; });
+  }
